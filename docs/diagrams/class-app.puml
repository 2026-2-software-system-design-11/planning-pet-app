@startuml class-app
!include class-common.iuml
left to right direction
package planningpet.app {
  class Main {
    {static} + main(args : String[]) : void
    {static} + dataFolder(args : String[]) : Path
  }
  class SingleInstance {
    - folder : Path
    - onSignal : Runnable
    + acquire() : boolean
  }
}
package planningpet.app.view {
  class AppWindow
  class Tray
  class UnreadableDialog {
    {static} + show(parent : Component, reason : Reason, file : Path) : void
    {static} + pane(reason : Reason, file : Path) : JOptionPane
  }
}
package planningpet.app.controller {
  class AppController {
    - windowVisible : boolean
    - sent : Set<ReminderKey>
    - errors : Consumer<String>
    + change(what : String, edit : Runnable) : void
    + onWindowShown() : void
    + say(line : String, day : LocalDate) : void
    + sayInRoom(line : String) : void
    + dueReminders(now : LocalDateTime) : List<Reminder>
    + onClose(traySupported : boolean) : CloseAction
    + quit() : void
  }
  class DayWatcher {
    - lastDay : LocalDate
    + tick(now : LocalDateTime) : void
  }
}
package planningpet.app.store {
  class SqliteDataStore {
    - folder : Path
    - saved : AppData
    + load() : LoadResult
    + save(data : AppData) : void
  }
  class Schema {
    {static} + VERSION : int = 1
    {static} + create(db : Connection) : void
    {static} + upgrade(db : Connection, from : int) : void
  }
}
package planningpet.app.model {
  class AppData {
    - points : int
    - rewardCountDay : LocalDate
    - rewardCount : int
    - attendanceDay : LocalDate
    - attendDays : Set<LocalDate>
    - lastOpenDay : LocalDate
    - streak : int
    - pets : List<PetState>
    - activeKind : PetKind
    - ownedItems : Set<ItemId>
    - placedItems : Set<ItemId>
    - trayNoticeShown : boolean
    - calendarFixed : boolean
    - listClickTime : boolean
    - sampleIds : Set<String>
    - sampleLooks : Map<String, SampleLook>
    - weekStart : DayOfWeek
    - nextSeq : long
    - clock : Clock
    - listeners : List<Runnable>
    + today() : LocalDate
    + activePet() : PetState
    + copy() : AppData
    + restore(copy : AppData) : void
    + onChange(listener : Runnable) : void
    + changed() : void
  }
  interface DataStore <<interface>> {
    + load() : LoadResult
    + save(data : AppData) : void
  }
  class Visits {
    + recordOpen(today : LocalDate) : int
  }
  class Examples {
    {static} + fill(data : AppData) : void
  }
}
AppWindow ..> AppController
AppWindow ..> AppData
Tray ..> AppController
Tray ..> DayWatcher
AppController --> "1" AppData
AppController --> "1" DataStore
AppController --> "1" planningpet.pet.model.Bubble
AppController ..> Visits
AppController ..> planningpet.pet.model.PetTalk
AppController ..> planningpet.schedule.model.Reminders
AppWindow ..> planningpet.reward.controller.RewardController
AppWindow ..> planningpet.pet.view.PetArt
Tray ..> planningpet.home.view.MainScreen
DayWatcher ..> AppData
DayWatcher --> "1" AppController
SqliteDataStore ..|> DataStore
SqliteDataStore ..> AppData
SqliteDataStore ..> Schema
AppData *-- "1" planningpet.schedule.model.TaskBook : book
AppData *-- "1..2" planningpet.pet.model.PetState : pets
@enduml
