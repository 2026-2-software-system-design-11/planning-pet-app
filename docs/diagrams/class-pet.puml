@startuml class-pet
!include class-common.iuml
left to right direction
package planningpet.pet.view {
  class PetScreen
  class RoomView
  class CharacterDialog
  class PickDialog
}
package planningpet.pet.controller {
  class PetController {
    + adopt(kind : PetKind, name : String) : boolean
    + select(kind : PetKind) : void
    + step(delta : int) : void
    + rename(kind : PetKind, name : String) : void
    + pose(kind : PetKind, pose : Pose) : void
    + applyWear(kind : PetKind, chosen : Map<Slot, WearId>) : void
  }
}
package planningpet.pet.model {
  class PetState {
    - kind : PetKind
    - name : String
    - exp : int
    - pose : Pose
    - wear : Map<Slot, WearId>
    + pat() : String
  }
  class PetTalk {
    + say(situation : Situation, ...) : String
  }
  class Bubble {
    - line : String
    - newLines : int
    - recountDay : LocalDate
    + say(line : String) : void
    + retell(line : String) : void
  }
  class Room {
    - data : AppData
    + toggle(item : ItemId) : void
  }
  class Bond {
    {static} + percent(tasks : List<Task>, kind : PetKind) : int
    {static} + days(tasks : List<Task>, kind : PetKind) : int
  }
  class Wardrobe {
    {static} + opensAt(wear : WearId) : int
    {static} + slotOf(wear : WearId) : Slot
  }
  class Poses
  enum PetKind <<enum>>
  enum Pose <<enum>>
  enum WearId <<enum>>
}
PetScreen *-- RoomView
PetScreen ..> PetController
CharacterDialog ..> PetController
PickDialog ..> PetController
RoomView ..> Bubble
PetController --> "1" planningpet.app.controller.AppController
PetController --> "1" planningpet.app.model.AppData
PetController ..> Wardrobe
PetController ..> PetTalk
PetState --> "1" PetKind
PetState --> "1" Pose
PetState --> "0..4" WearId : wear
Room --> "1" planningpet.app.model.AppData
@enduml
