@startuml class-schedule-rules
!include class-common.iuml
left to right direction
package planningpet.schedule.view {
  class ScheduleScreen
  class TimetablePanel
  class TaskRows
  class TaskDialog
  class TimeEditor
  class AutoPlaceDialog
}
package planningpet.schedule.controller {
  class TaskController {
    + add(draft : TaskDraft, ask : Predicate<Overlap>) : boolean
    + update(task : Task, draft : TaskDraft, scope : EditScope) : boolean
    + clearTime(task : Task, scope : EditScope) : void
    + placeAt(task : Task, day : LocalDate, start : int, scope : EditScope) : String
    + undoPlace() : void
    + delete(task : Task, scope : DeleteScope) : void
    + applyPlacement(p : Placement) : void
    + clearSamples(confirm : Predicate<String>) : int
  }
}
package planningpet.schedule.model {
  class DefaultDates {
    {static} + forAdd(screen : Screen, selected : LocalDate, shownStart : LocalDate, today : LocalDate) : LocalDate
    {static} + defaultStart(date : LocalDate, now : LocalDateTime) : int
    {static} + repeatEndFor(kind : Kind, start : LocalDate) : LocalDate
    {static} + dueFor(date : LocalDate, weekStart : DayOfWeek) : LocalDate
  }
  class Reminders {
    {static} + due(book : TaskBook, now : LocalDateTime, sent : Set<ReminderKey>) : List<Reminder>
  }
  class AutoPlacer {
    {static} + place(book : TaskBook, weekStart : LocalDate, now : LocalDateTime) : Placement
    {static} + reason(task : Task, book : TaskBook, weekStart : LocalDate, now : LocalDateTime) : String
  }
  class TimetableLayout {
    {static} + of(dayTasks : List<Task>) : List<Slot>
    {static} + top(monday : LocalDate, now : LocalDateTime) : int
  }
  class CalendarCell {
    {static} + preview(book : TaskBook, date : LocalDate, withFixed : boolean) : CellPreview
  }
  class Typed {
    {static} + minutes(text : String) : Read
    {static} + start(text : String, day : LocalDate, due : LocalDate) : Read
  }
  class TaskBook
  class TaskDraft
}
ScheduleScreen *-- TimetablePanel
ScheduleScreen *-- TaskRows
ScheduleScreen ..> TaskController
TaskDialog ..> TaskController
TimeEditor ..> TaskController
AutoPlaceDialog ..> TaskController
TaskDialog ..> DefaultDates
TaskDialog ..> Typed
TimeEditor ..> Typed
TimetablePanel ..> TimetableLayout
AutoPlaceDialog ..> AutoPlacer
TaskController --> "1" TaskBook
TaskController --> "1" planningpet.app.controller.AppController
TaskController ..> TaskDraft
AutoPlacer ..> TaskBook
Reminders ..> TaskBook
CalendarCell ..> TaskBook
@enduml
